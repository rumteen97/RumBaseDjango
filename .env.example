DJANGO_SETTINGS_MODULE="config.settings.development"    # development, production
SECRET_KEY ="secret_key"    # development, production
ALLOWED_HOSTS=["*"]    # production
CSRF_TRUSTED_ORIGINS=["http://*", "https://*"]    # production
CORS_ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "https://example.com"]    # production

# Database configs
DATABASE_NAME="DBname"    # development, production
DATABASE_USER="root"    # development, production
DATABASE_PASSWORD="123456789"    # development, production
DATABASE_HOST="localhost"    # development, production
DATABASE_PORT="5432"    # development, production


# Redis
REDIS_LOCATION=redis://127.0.0.1:6379/0